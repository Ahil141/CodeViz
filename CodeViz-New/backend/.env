# HuggingFace Token (Required for LLaMA models)
# Get your token from: https://huggingface.co/settings/tokens
# Accept model access at: https://huggingface.co/meta-llama/Meta-Llama-3-8B
HUGGINGFACE_TOKEN=your_token_here

# LLM Configuration
LLM_MODEL_PATH=Qwen/Qwen2.5-Coder-1.5B-Instruct
# LLM_DEVICE_MAP=auto
LLM_TORCH_DTYPE=float16
LLM_MAX_LENGTH=512
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_DO_SAMPLE=true

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=codelearn_documents
CHROMA_EMBEDDING_MODEL=all-MiniLM-L6-v2
